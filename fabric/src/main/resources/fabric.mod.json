{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "${mod_home}",
    "issues": "${mod_issues}",
    "sources": "${mod_source}"
  },
  "license": "${mod_license}",
  "environment": "client",
  "icon": "${mod_icon}",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version_range}"
  }
}
